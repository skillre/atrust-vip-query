        <!-- ============ 数据流连线 ============ -->
        <!-- 1. aTrust Syslog → SyslogReceiver -->
        <mxCell id="70" value="Syslog 日志流&#xa;(UDP/TCP:514)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="12" target="21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 2. aTrust OpenAPI → ApiCollector -->
        <mxCell id="71" value="HTTPS + HMAC-SHA256 轮询" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="13" target="22">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 3. 运维 CSV/Excel → FileImporter（绕行：走泳道间隙走廊） -->
        <mxCell id="72" value="上传日志文件（CSV / Excel）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="15" target="23">
