        <!-- 6. FileImporter → SQLite -->
        <mxCell id="75" value="导入数据落库" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="23" target="24">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 7. models.py → SQLite（契约约束，虚线） -->
        <mxCell id="76" value="数据契约约束" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="25" target="24">
          <mxGeometry relative="1" as="geometry" />
