<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="系统架构图" id="arch-main">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1350" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 总标题 -->
        <mxCell id="5" value="aTrust 用户虚拟IP查询系统 — 系统架构图（数据流：外部数据源 → 采集 → 存储 → API → 前端）" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="8" width="1300" height="26" as="geometry" />
        </mxCell>

        <!-- ============ 泳道 1：外部数据源 ============ -->
        <mxCell id="10" value="① 外部数据源（External）" style="swimlane;startSize=32;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontStyle=1;fontSize=15;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1320" height="200" as="geometry" />
        </mxCell>

        <!-- aTrust 设备容器 -->
        <mxCell id="11" value="aTrust 零信任设备（数据产生方）" style="rounded=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;container=1;pointerEvents=0;fontColor=#333333;" vertex="1" parent="10">
          <mxGeometry x="40" y="45" width="580" height="110" as="geometry" />
        </mxCell>
        <mxCell id="12" value="Syslog 日志流&#xa;（UDP/TCP :514）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="11">
          <mxGeometry x="30" y="45" width="240" height="55" as="geometry" />
        </mxCell>
        <mxCell id="13" value="OpenAPI 接口&#xa;（HTTPS + HMAC 签名）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="11">
          <mxGeometry x="310" y="45" width="240" height="55" as="geometry" />
        </mxCell>

        <!-- 运维人员容器 -->
        <mxCell id="14" value="运维人员（离线数据来源）" style="rounded=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;container=1;pointerEvents=0;fontColor=#333333;" vertex="1" parent="10">
          <mxGeometry x="660" y="45" width="580" height="120" as="geometry" />
        </mxCell>
        <mxCell id="15" value="导出日志文件&#xa;（CSV / Excel）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="14">
          <mxGeometry x="180" y="45" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- ============ 泳道 2：采集与存储 ============ -->
        <mxCell id="20" value="② 采集与存储（Collector + Storage）" style="swimlane;startSize=32;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontStyle=1;fontSize=15;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="1320" height="350" as="geometry" />
        </mxCell>

        <mxCell id="21" value="SyslogReceiver&#xa;接收 → 解析 → 批量队列&#xa;（parse_workers=4）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="20">
          <mxGeometry x="60" y="50" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="22" value="ApiCollector&#xa;AtrustClient（HMAC 签名）&#xa;轮询在线用户 / VIP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="20">
          <mxGeometry x="60" y="140" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="23" value="FileImporter&#xa;CSV / Excel 解析（openpyxl）&#xa;后台异步导入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="20">
          <mxGeometry x="60" y="230" width="300" height="70" as="geometry" />
        </mxCell>

        <mxCell id="24" value="SQLite（WAL 模式）&#xa;vip_data.db&#xa;&#xa;users&#xa;vip_records（历史，保留 14 天）&#xa;user_current_vip（最新态）&#xa;search_logs&#xa;import_logs" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="20">
          <mxGeometry x="460" y="75" width="230" height="200" as="geometry" />
        </mxCell>

        <mxCell id="25" value="数据契约层（models.py / database.py）&#xa;Pydantic 模型：UserInfo / VipRecord / VipQueryResult /&#xa;VipReverseResult / ApiResponse / ImportLog ...&#xa;&#xa;SQLite CRUD、批量写入（executemany 单事务）&#xa;连接按线程隔离（threading.local）&#xa;所有模块依赖此契约，schema 改动需手动 ALTER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="20">
          <mxGeometry x="760" y="75" width="480" height="180" as="geometry" />
        </mxCell>

        <!-- ============ 泳道 3：API 服务层 ============ -->
        <mxCell id="30" value="③ API 服务层（FastAPI / uvicorn）" style="swimlane;startSize=32;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontStyle=1;fontSize=15;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="1320" height="240" as="geometry" />
        </mxCell>

        <mxCell id="31" value="FastAPI 应用（app.py 入口）&#xa;uvicorn 启动 · 生命周期管理&#xa;（初始化 DB / 启停 Syslog）&#xa;CORS 中间件 · 静态文件服务&#xa;（托管 React 构建产物）&#xa;后台定时清理线程（6h / 次）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="30">
          <mxGeometry x="60" y="45" width="280" height="150" as="geometry" />
        </mxCell>

        <mxCell id="32" value="routes.py（查询 / 导入 / 导出）&#xa;/vip/query · /vip/query/batch · /vip/reverse&#xa;/vip/history · /vip/online · /user/list&#xa;/import/upload · /import/preview · /import/progress/{id}&#xa;/export/csv · /system/health · /system/stats" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="30">
          <mxGeometry x="380" y="45" width="360" height="150" as="geometry" />
        </mxCell>

        <mxCell id="33" value="dashboard_routes.py（仪表盘 / 系统配置）&#xa;/dashboard/stats · /search/recent&#xa;/import/history · /system/status-full&#xa;/system/config（GET / PUT / reset）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="30">
          <mxGeometry x="780" y="45" width="300" height="150" as="geometry" />
        </mxCell>

        <mxCell id="34" value="横切关注点&#xa;config.yaml 全局配置&#xa;loguru 日志（滚动）&#xa;统一 ApiResponse 信封&#xa;（code / message / data）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="30">
          <mxGeometry x="1120" y="45" width="160" height="150" as="geometry" />
        </mxCell>

        <!-- ============ 泳道 4：前端展示层 ============ -->
        <mxCell id="40" value="④ 前端展示层（React 19 SPA / Vite）" style="swimlane;startSize=32;fillColor=#f5f5f5;strokeColor=#666666;whiteSpace=wrap;html=1;fontStyle=1;fontSize=15;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="980" width="1320" height="200" as="geometry" />
        </mxCell>

        <mxCell id="41" value="React 19 SPA 核心&#xa;react-router-dom 路由&#xa;API 客户端（fetch /api/v1）&#xa;组件：Nav / Toast / ErrorBoundary / StatsRow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="40">
          <mxGeometry x="60" y="45" width="520" height="115" as="geometry" />
        </mxCell>

        <mxCell id="42" value="功能面板&#xa;查询面板 · 反查面板 · 批量查询 · 历史记录&#xa;导入面板（含进度弹窗） · 导出面板&#xa;系统设置页 · 仪表盘（StatsRow 统计）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="40">
          <mxGeometry x="620" y="45" width="660" height="115" as="geometry" />
        </mxCell>

        <!-- ============ 部署信息 ============ -->
        <mxCell id="50" value="Docker 单容器部署（多阶段构建：node 构建前端 → python 运行时）&#xa;端口：:8000（FastAPI + React SPA 静态托管） · :514/udp · :514/tcp（Syslog 接收）&#xa;命名卷：config.yaml（挂载写回） · vip-data（SQLite） · vip-logs（loguru 日志）&#xa;HEALTHCHECK /api/v1/system/health · restart=unless-stopped · 时区 Asia/Shanghai" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1210" width="900" height="100" as="geometry" />
