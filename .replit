# ============================================================
# aTrust 用户虚拟IP查询系统 - Replit 配置
# ============================================================

# 运行配置
run = "python app.py"

# 解释器配置
[interpreter]
channel = "python-3.11"

# 包管理
[nix]
channel = "stable-24_05"

# 环境变量
[env]
PYTHONUNBUFFERED = "1"

# 部署配置
[deployment]
run = ["sh", "-c", "pip install -r requirements.txt && python app.py"]
