# ============================================================
# aTrust 用户虚拟IP查询系统 - 配置文件
# ============================================================

# ============================================================
# aTrust 设备配置（可选 - 如不配置则使用导入模式）
# ============================================================
# 如果你的 aTrust 设备可以通过网络访问，配置以下信息可启用实时查询
# 如果无法直连设备，请留空，通过 Web 界面导入日志文件
atrust:
  # aTrust控制台地址（HTTPS），无法直连时留空
  host: ""  # 例: "https://192.168.1.100:4433"
  
  # API认证信息（从控制台获取），无法直连时留空
  api_id: ""   # 例: "your_api_id"
  api_key: ""  # 例: "your_api_key"
  
  # API查询超时（秒）
  timeout: 10

# Syslog 接收配置（可选 - 需要 aTrust 设备能访问本机）
syslog:
  # 是否启用Syslog接收，无法接收时设为 false
  enabled: false
  
  # 监听地址（0.0.0.0表示所有网卡）
  host: "0.0.0.0"
  
  # 监听端口
  port: 514
  
  # 协议类型：udp 或 tcp（Replit 等不支持 UDP 暴露的平台请用 tcp）
  protocol: "udp"

# 数据库配置
database:
  # SQLite数据库文件路径
  path: "./data/vip_data.db"
  
  # 数据保留天数（自动清理过期记录）
  retention_days: 14

# Web 界面配置（Streamlit）
web:
  # 监听地址
  host: "0.0.0.0"
  
  # 监听端口
  port: 8501
  
  # 页面标题
  title: "aTrust 用户虚拟IP查询系统"

# API 服务配置（FastAPI）
api:
  # 监听地址
  host: "0.0.0.0"
  
  # 监听端口
  port: 8000
  
  # 是否开启调试模式
  debug: false

# 日志配置
logging:
  # 日志级别：DEBUG, INFO, WARNING, ERROR
  level: "INFO"
  
  # 日志文件路径
  file: "./logs/app.log"
  
  # 日志文件最大大小（MB）
  max_size: 10
  
  # 保留日志文件数量
  backup_count: 5
