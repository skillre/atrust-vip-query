# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# 虚拟环境
venv/
env/
.venv/
.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride

# 数据文件（运行时生成）
data/
*.db
*.sqlite
*.sqlite3

# 日志文件
logs/
*.log

# 配置文件（包含敏感信息）
config.yaml
config.yml

# 环境变量文件
.env
.env.local
.env.production

# 测试覆盖率
htmlcov/
.coverage
.coverage.*
coverage.xml

# 临时文件
tmp/
temp/
*.tmp

# React 前端
frontend/node_modules/
frontend/dist/
static/
